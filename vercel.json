{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "redirects": [
    {
      "source": "/fr",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/fr/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/:path(about|projects|skills|experience|contact)",
      "destination": "/en",
      "permanent": true
    },
    {
      "source": "/it/:path(about|projects|skills|experience|contact)",
      "destination": "/it",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/cv/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
