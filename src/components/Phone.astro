---
// Cadre d'iPhone dessiné en CSS. Contient une capture, ou une vidéo via le slot.
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Props {
  src?: ImageMetadata;
  alt?: string;
  eager?: boolean;
  sizes?: string;
  class?: string;
}
const {
  src,
  alt = "",
  eager = false,
  sizes = "(min-width: 1024px) 320px, 46vw",
  class: cls,
} = Astro.props;
---

<div class:list={["phone", cls]}>
  <div class="phone-body">
    <div class="phone-screen">
      {src && (
        <Picture
          src={src}
          alt={alt}
          formats={["avif"]}
          fallbackFormat="webp"
          widths={[240, 360, 480, 640]}
          sizes={sizes}
          loading={eager ? "eager" : "lazy"}
          fetchpriority={eager ? "high" : "auto"}
          decoding="async"
        />
      )}
      <slot />
      <span class="phone-island" aria-hidden="true"></span>
    </div>
  </div>
</div>

<style>
  /* Le conteneur donne ses unités cqw au corps : tout le cadre suit la largeur */
  .phone {
    container-type: inline-size;
  }
  .phone-body {
    position: relative;
    aspect-ratio: 1206 / 2622;
    padding: 3.1cqw;
    border-radius: 16.5cqw;
    background: linear-gradient(145deg, #3a3c40, #16171a 38%, #2a2b2f 70%, #111214);
    box-shadow:
      0 0 0 0.45cqw #4a4c51 inset,
      0 1.5cqw 3cqw -1cqw rgb(0 0 0 / 0.35),
      0 6cqw 14cqw -4cqw rgb(15 17 21 / 0.45);
  }
  .phone-screen {
    position: relative;
    height: 100%;
    overflow: hidden;
    border-radius: 13.4cqw;
    background: #000;
  }
  .phone-screen :global(img),
  .phone-screen :global(video) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .phone-screen :global(picture) {
    display: contents;
  }
  .phone-island {
    position: absolute;
    top: 2.6cqw;
    left: 50%;
    width: 30cqw;
    height: 8.6cqw;
    translate: -50% 0;
    border-radius: 999px;
    background: #000;
  }
</style>
