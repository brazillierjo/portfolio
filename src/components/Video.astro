---
// Vidéo muette en boucle : chargée et lue seulement quand elle est visible,
// avec un bouton pause (WCAG 2.2.2). Sans JavaScript, l'affiche reste visible.
// `eager` (vidéo du hero) : l'affiche sert de premier rendu, la vidéo arrive
// une fois la page chargée et le fil principal libre.
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import { COPY, type Lang } from "@/i18n/copy";

interface Props {
  src: string;
  poster: ImageMetadata;
  posterWidth?: number;
  label: string;
  lang: Lang;
  class?: string;
  eager?: boolean;
}
const { src, poster, posterWidth = 1080, label, lang, class: cls, eager = false } = Astro.props;
const posterImg = await getImage({
  src: poster,
  width: Math.min(posterWidth, poster.width),
  format: "webp",
  quality: 78,
});
const t = COPY[lang];
---

<div class:list={["video", cls]} data-video data-hero={eager ? "" : undefined}>
  <video
    muted
    loop
    playsinline
    disablepictureinpicture
    preload="none"
    poster={posterImg.src}
    width={poster.width}
    height={poster.height}
    aria-label={label}
    data-src={src}
  ></video>
  <button
    type="button"
    class="video-toggle"
    data-video-toggle
    data-label-play={t.playVideo}
    data-label-pause={t.pauseVideo}
    aria-label={t.playVideo}
    hidden
  >
    <svg viewBox="0 0 16 16" aria-hidden="true" class="i-play">
      <path d="M4.5 2.8v10.4L13 8z" fill="currentColor"></path>
    </svg>
    <svg viewBox="0 0 16 16" aria-hidden="true" class="i-pause">
      <path d="M4 2.5h3v11H4zM9 2.5h3v11H9z" fill="currentColor"></path>
    </svg>
  </button>
</div>

<style>
  .video {
    position: relative;
    height: 100%;
  }
  video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: #000;
  }
  .video-toggle {
    position: absolute;
    right: 10px;
    bottom: 10px;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    border: 0;
    color: #fff;
    background: rgb(0 0 0 / 0.55);
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.2s;
  }
  .video:hover .video-toggle,
  .video-toggle:focus-visible,
  .video[data-paused] .video-toggle {
    opacity: 1;
  }
  .video-toggle svg {
    width: 14px;
    height: 14px;
  }
  .video:not([data-paused]) .i-play,
  .video[data-paused] .i-pause {
    display: none;
  }
</style>
