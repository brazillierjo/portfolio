---
import { Image } from "astro:assets";
import avatar from "@/assets/me/avatar.png";
import { PROFILE } from "@/data/profile";
import { COPY, type Lang } from "@/i18n/copy";
import { IDS } from "@/i18n/ids";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = COPY[lang];
const c = t.contact;
---

<section id={IDS[lang].contact} class="contact" data-theme="paper">
  <div class="wrap">
    <div class="card sheet">
      <div class="who">
        <Image src={avatar} alt="" width={160} height={160} class="avatar" loading="lazy" />
        <div>
          <h2 class="title">{c.title}</h2>
          <p class="name">
            {PROFILE.name}, {PROFILE.role}
          </p>
        </div>
      </div>

      <dl class="ways">
        <div class="way">
          <dt>{c.email}</dt>
          <dd>
            <a class="value" href={`mailto:${PROFILE.email}`}>
              {PROFILE.email}
            </a>
            <button
              type="button"
              class="btn small-btn"
              data-copy={PROFILE.email}
              data-copied={c.copied}
              hidden
            >
              {c.copy}
            </button>
            <span class="sr-only" aria-live="polite" data-copy-status></span>
          </dd>
        </div>
        <div class="way">
          <dt>{c.phone}</dt>
          <dd>
            <a class="value num" href="#" data-phone={PROFILE.phoneParts.join(" ")} hidden>
              …
            </a>
          </dd>
        </div>
        <div class="way">
          <dt>{c.cvTitle}</dt>
          <dd>
            {c.cv.map((x, i) => (
              <a
                class:list={["btn small-btn", { "btn-green": i === 0 }]}
                href={PROFILE.cv[x.lang]}
                download
                hreflang={x.lang}
              >
                <svg viewBox="0 0 16 16" aria-hidden="true">
                  <path
                    d="M8 2v8m0 0L4.5 6.5M8 10l3.5-3.5M3 13.5h10"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
                {x.label}
              </a>
            ))}
          </dd>
        </div>
        <div class="way">
          <dt>{c.elsewhere}</dt>
          <dd class="elsewhere">
            <a class="link" href={PROFILE.linkedin} rel="me noopener" target="_blank">
              LinkedIn
            </a>
            <a class="link" href={PROFILE.github} rel="me noopener" target="_blank">
              GitHub
            </a>
          </dd>
        </div>
      </dl>
    </div>

    <footer class="foot small">
      <p>
        © {new Date().getFullYear()} {PROFILE.name}
      </p>
      <p>
        {t.footer}
        <button type="button" class="manage" data-consent-open>
          {t.consent.manage}
        </button>
      </p>
    </footer>
  </div>
</section>

<style>
  .contact {
    padding-block: var(--section) 28px;
  }
  .card {
    padding: clamp(24px, 4vw, 48px);
  }
  .who {
    display: flex;
    align-items: center;
    gap: clamp(14px, 2vw, 22px);
  }
  .avatar {
    width: clamp(60px, 6vw, 76px);
    height: auto;
    border-radius: 999px;
    outline: 1px solid rgb(0 0 0 / 0.1);
    outline-offset: -1px;
  }
  .who .title {
    margin: 0;
    color: var(--ink);
  }
  .name {
    margin: 4px 0 0;
    color: var(--muted);
    font-weight: 700;
  }
  .ways {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 4px clamp(20px, 4vw, 56px);
    margin: clamp(22px, 3vw, 34px) 0 0;
  }
  /* Rangées de Mio : un liseré, pas de boîte dans la boîte */
  .way {
    padding: 16px 0 18px;
    border-top: 1px solid var(--line);
  }
  .way dt {
    margin-bottom: 8px;
    font-size: var(--step--1);
    font-weight: 800;
    color: var(--muted);
  }
  .way dd {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
  .value {
    font-size: var(--step-2);
    font-weight: 900;
    letter-spacing: -0.02em;
    color: var(--ink);
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  @media (hover: hover) and (pointer: fine) {
    .value:hover {
      color: var(--green-ink);
    }
  }
  .small-btn {
    min-height: 40px;
    padding: 0 14px;
    font-size: 0.9375rem;
  }
  .elsewhere {
    font-size: var(--step-1);
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 6px 24px;
    margin-top: 28px;
    color: var(--muted);
    font-weight: 600;
  }
  .foot p {
    margin: 0;
  }
  .manage {
    margin-left: 10px;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-weight: 800;
    color: var(--ink-2);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }
  @media (max-width: 760px) {
    .ways {
      grid-template-columns: 1fr;
    }
  }
</style>
