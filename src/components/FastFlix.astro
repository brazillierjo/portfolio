---
import Phone from "./Phone.astro";
import Project from "./Project.astro";
import Video from "./Video.astro";
import poster from "@/assets/fastflix/demo-poster.jpg";
import icon from "@/assets/fastflix/icon.png";
import demoMp4 from "@/assets/video/fastflix-demo.mp4?url";
import { LINKS } from "@/data/profile";
import { COPY, type Lang } from "@/i18n/copy";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = COPY[lang];
const f = t.fastflix;
const stack = [
  "Expo SDK 58",
  "React Native",
  "NativeWind",
  "TanStack Query",
  "Reanimated 4",
  "Hono",
  "Node.js 24",
  "Turso (libSQL)",
  "Gemini 2.5 Flash Lite",
  "TMDB",
  "RevenueCat",
  "Sentry",
  "Aptabase",
  "Next.js",
  "Docker",
];
---

<Project
  id="fastflix"
  colors={{ accent: "#e5251a", edge: "#b31a11", label: "#ffffff", stage: "#fbe4e1" }}
  name="FastFlix"
  icon={icon}
  teaser={f}
  lang={lang}
  links={[
    { href: LINKS.fastflix.site, label: f.links.site },
    { href: LINKS.fastflix.appStore, label: f.links.appStore },
    { href: LINKS.fastflix.play, label: f.links.play },
  ]}
>
  <figure slot="visual" class="demo">
    <Phone>
      <Video src={demoMp4} poster={poster} posterWidth={600} label={f.videoLabel} lang={lang} />
    </Phone>
  </figure>

  <p class="lead intro">{f.intro}</p>
  <p class="note">{f.videoCaption}</p>

  <ol class="flow">
    {f.steps.map((s) => (
      <li>
        <h5>{s.title}</h5>
        <p>{s.text}</p>
      </li>
    ))}
  </ol>

  <h4 class="h">{t.stackLabel}</h4>
  <ul class="tags">
    {stack.map((x) => (
      <li>{x}</li>
    ))}
  </ul>
</Project>

<style>
  .demo {
    margin: 0;
    width: min(100%, 270px);
  }
  @media (max-width: 900px) {
    .demo {
      width: min(62%, 230px);
    }
  }
  .note {
    margin: 10px 0 0;
    font-size: var(--step--1);
    color: var(--muted);
  }
  .demo figcaption {
    margin-top: 12px;
    text-align: center;
    font-size: var(--step--1);
    color: var(--muted);
  }
  .intro {
    margin: 0;
    max-width: 62ch;
  }
  .flow {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 clamp(18px, 2.4vw, 32px);
    list-style: none;
    padding: 0;
    margin: clamp(28px, 3.5vw, 44px) 0 0;
  }
  .flow li {
    padding-top: 16px;
    border-top: 2px solid var(--c);
  }
  h5 {
    margin: 0 0 6px;
    font-size: 1.125rem;
    font-weight: 850;
    line-height: 1.25;
    letter-spacing: -0.015em;
  }
  .flow p {
    margin: 0;
    color: var(--muted);
    font-size: var(--step--1);
  }
  .h {
    margin: clamp(36px, 4.5vw, 56px) 0 14px;
    font-size: var(--step-2);
    font-weight: 850;
    letter-spacing: -0.025em;
  }
  @media (max-width: 760px) {
    .flow {
      grid-template-columns: 1fr;
      row-gap: 24px;
    }
  }
</style>
