---
import Phone from "./Phone.astro";
import Video from "./Video.astro";
import ffFeed from "@/assets/fastflix/feed.png";
import mioToday from "@/assets/mio/today.png";
import officePoster from "@/assets/shelltown/office-poster.webp";
import officeMp4 from "@/assets/video/shelltown-office.mp4?url";
import { ACTIVITY, AGENT_SHARE, PROFILE } from "@/data/profile";
import { COPY, n, type Lang } from "@/i18n/copy";
import { IDS } from "@/i18n/ids";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = COPY[lang];
const chips = t.hero.chips(n(lang, ACTIVITY.total), AGENT_SHARE);
---

<section id="top" class="hero" data-theme="paper">
  <div class="wrap">
    <h1 class="title-block">
      <span class="name enter" style="--stagger:0">
        {PROFILE.name}
      </span>
      <span class="role display">
        <span class="enter" style="--stagger:1">
          AI Full Stack
        </span>{" "}
        <span class="enter" style="--stagger:2">
          Engineer
        </span>
      </span>
    </h1>

    <div class="grid">
      <div class="text">
        <p class="lead enter" style="--stagger:3">
          {t.hero.lead}
        </p>
        <div class="cta enter" style="--stagger:4">
          <a class="btn btn-green" href={`#${IDS[lang].contact}`}>
            {t.hero.ctaContact}
          </a>
          <a class="btn" href={PROFILE.cv[lang]} download>
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path
                d="M8 2v8m0 0L4.5 6.5M8 10l3.5-3.5M3 13.5h10"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path>
            </svg>
            {t.hero.ctaCv}
          </a>
        </div>
      </div>

      <div class="stage">
        <figure class="mac enter" style="--stagger:2">
          <div class="mac-frame">
            <Video
              src={officeMp4}
              poster={officePoster}
              label={t.shelltown.videoLabel}
              lang={lang}
              eager
            />
          </div>
          <figcaption class="sr-only">{t.hero.figures.shelltown}</figcaption>
        </figure>
        <figure class="ph ph-mio enter" style="--stagger:4">
          <Phone
            src={mioToday}
            alt={t.mio.steps[0]!.alt}
            eager
            sizes="(min-width: 1024px) 200px, 30vw"
          />
          <figcaption class="sr-only">{t.hero.figures.mio}</figcaption>
        </figure>
        <figure class="ph ph-ff enter" style="--stagger:5">
          <Phone
            src={ffFeed}
            alt={t.fastflix.steps[2]!.alt}
            sizes="(min-width: 1024px) 180px, 26vw"
          />
          <figcaption class="sr-only">{t.hero.figures.fastflix}</figcaption>
        </figure>
        <p class="chip chip-commits enter" style="--stagger:6">
          <span class="chip-icon" aria-hidden="true">
            <svg viewBox="0 0 20 20">
              <circle
                cx="10"
                cy="10"
                r="3.2"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
              ></circle>
              <path
                d="M2 10h4.6M13.4 10H18"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
              ></path>
            </svg>
          </span>
          <span>
            <strong class="num">{chips.commits}</strong>
            <span class="chip-sub">{chips.commitsSub}</span>
          </span>
        </p>
        <p class="chip chip-platforms enter" style="--stagger:7">
          <span class="chip-icon" aria-hidden="true">
            <svg viewBox="0 0 20 20">
              <rect
                x="3"
                y="4"
                width="14"
                height="10"
                rx="2"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              ></rect>
              <path
                d="M7 17h6"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
              ></path>
            </svg>
          </span>
          <span>
            <strong>{chips.platforms}</strong>
            <span class="chip-sub">{chips.platformsSub}</span>
          </span>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    --role: clamp(2.75rem, 1rem + 6.6vw, 6.5rem);
    padding-top: calc(var(--header-h) + clamp(28px, 4vw, 56px));
    padding-bottom: clamp(56px, 7vw, 96px);
    overflow: clip;
  }
  .title-block {
    margin: 0;
    color: var(--ink);
  }
  .name {
    display: block;
    font-size: var(--step-1);
    font-weight: 800;
    color: var(--muted);
    margin-bottom: 10px;
  }
  .role {
    display: block;
    font-size: var(--role);
  }
  .role > span {
    display: block;
    white-space: nowrap;
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
    margin-top: clamp(28px, 4vw, 48px);
  }
  /* Grand écran : la scène remonte à droite de « Engineer » */
  @media (min-width: 1024px) {
    .grid {
      margin-top: calc(var(--role) * -1 + 4px);
    }
    .text {
      padding-top: calc(var(--role) + clamp(24px, 3vw, 40px));
    }
  }
  .lead {
    margin: 0;
    max-width: 36ch;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  /* La scène : macOS au fond, deux iPhone devant, deux pastilles de données */
  .stage {
    position: relative;
    padding-bottom: 16%;
  }
  figure {
    margin: 0;
  }
  .mac-frame {
    overflow: hidden;
    aspect-ratio: 1080 / 684;
    border-radius: 12px;
    background: #060f10;
    box-shadow: var(--shadow-float);
  }
  .ph {
    position: absolute;
  }
  .ph-mio {
    width: 27%;
    left: -8%;
    bottom: 0;
  }
  .ph-ff {
    width: 23%;
    right: -2%;
    bottom: 4%;
  }
  .chip {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    padding: 10px 14px 10px 10px;
    border-radius: var(--r-tile);
    background: var(--sheet);
    box-shadow: var(--shadow-float);
    line-height: 1.2;
  }
  .chip strong {
    display: block;
    font-weight: 900;
    color: var(--ink);
  }
  .chip-sub {
    display: block;
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--muted);
  }
  /* Rayon concentrique : 16 de pastille = 6 de marge + 10 d'icône */
  .chip-icon {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: var(--green);
    color: #fff;
    box-shadow: inset 0 -3px 0 rgb(0 0 0 / 0.18);
    flex: none;
  }
  .chip-icon svg {
    width: 20px;
    height: 20px;
  }
  .chip-commits {
    top: -6%;
    left: 6%;
  }
  .chip-platforms {
    right: 22%;
    bottom: -2%;
  }
  .chip-platforms .chip-icon {
    background: var(--ink-2);
  }

  @media (max-width: 1023px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .lead {
      max-width: 46ch;
    }
    .stage {
      margin: 24px 4% 0 6%;
    }
  }
  @media (max-width: 560px) {
    .stage {
      margin-inline: 8% 0;
      padding-bottom: 26%;
    }
    .ph-mio {
      width: 31%;
      left: -10%;
    }
    .ph-ff {
      width: 27%;
      right: -2%;
    }
    .chip {
      padding: 7px 10px 7px 7px;
      gap: 8px;
    }
    .chip strong {
      font-size: 0.875rem;
    }
    .chip-sub {
      font-size: 0.6875rem;
    }
    .chip-icon {
      width: 28px;
      height: 28px;
      border-radius: 8px;
    }
    .chip-commits {
      top: -10%;
      left: -4%;
    }
    .chip-platforms {
      right: 18%;
      bottom: 0;
    }
    .cta .btn {
      flex: 1 1 auto;
    }
  }
</style>
