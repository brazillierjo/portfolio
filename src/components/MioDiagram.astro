---
// Schéma d'architecture de Mio. Les nœuds sont du HTML (lisible à toutes
// les tailles), les liaisons un SVG en pourcentages posé dessous.
// Grille 3 × 3 : colonnes à 1/6, 3/6, 5/6 ; rangées idem.
import { COPY, type Lang } from "@/i18n/copy";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = COPY[lang].mio.diagram;

const nodes = [
  { id: "web", col: 1, row: 1, title: d.web, sub: d.webSub },
  { id: "app", col: 2, row: 1, title: d.app, sub: d.appSub, key: true },
  { id: "live", col: 3, row: 1, title: d.live, sub: d.liveSub, key: true },
  { id: "admin", col: 1, row: 2, title: d.admin, sub: d.adminSub },
  { id: "api", col: 2, row: 2, title: d.api, sub: d.apiSub, key: true },
  { id: "ai", col: 3, row: 2, title: d.ai, sub: d.aiSub },
  { id: "studio", col: 1, row: 3, title: d.studio, sub: d.studioSub },
  { id: "db", col: 2, row: 3, title: d.db, sub: d.dbSub, key: true },
  { id: "pay", col: 3, row: 3, title: d.pay, sub: d.paySub },
];
const c = (i: number) => ((i * 2 - 1) / 6) * 100;
const edge = (a: [number, number], b: [number, number]) => ({
  x1: c(a[0]),
  y1: c(a[1]),
  x2: c(b[0]),
  y2: c(b[1]),
});
const edges = [
  { ...edge([2, 1], [3, 1]), kind: "voice" },
  { ...edge([2, 1], [2, 2]), kind: "flow" },
  { ...edge([2, 2], [3, 1]), kind: "relay" },
  { ...edge([2, 2], [3, 2]), kind: "flow" },
  { ...edge([2, 2], [2, 3]), kind: "flow" },
  { ...edge([1, 2], [2, 2]), kind: "plain" },
  { ...edge([1, 1], [2, 2]), kind: "plain" },
  { ...edge([1, 3], [2, 3]), kind: "plain" },
  { ...edge([3, 3], [2, 2]), kind: "plain" },
];
---

<div class="diagram" data-diagram role="img" aria-label={`${d.title}. ${d.desc}`}>
  <div class="canvas">
    <svg class="lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      {edges.map((e) => (
        <>
          <line x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} class={`ln ln-${e.kind}`} />
          {(e.kind === "voice" || e.kind === "flow") && (
            <line x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} class={`pulse pulse-${e.kind}`} />
          )}
        </>
      ))}
    </svg>
    <span class="tag tag-ws">{d.ws}</span>
    <span class="tag tag-relay">{d.relay}</span>
    {nodes.map((n) => (
      <div
        class:list={["node", { key: n.key }]}
        style={`grid-column:${n.col};grid-row:${n.row}`}
        aria-hidden="true"
      >
        <strong>{n.title}</strong>
        <span>{n.sub}</span>
      </div>
    ))}
  </div>
</div>

<style>
  /* Le schéma garde sa propre palette claire, quel que soit le fond de la carte */
  .diagram {
    --fg: #22303c;
    --muted: #4b5a68;
    --line: #c6dbec;
    --accent: #1666a3;
    --accent-2: #33b45a;
    --surface: #ffffff;
    color: var(--fg);
    margin: clamp(20px, 2.4vw, 28px) 0 0;
    padding: clamp(16px, 3vw, 40px);
    border-radius: clamp(20px, 2.4vw, 32px);
    background: var(--sheet);
    box-shadow:
      0 1px 0 var(--line),
      0 30px 60px -40px rgb(28 117 184 / 0.45);
  }
  .canvas {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-rows: repeat(3, minmax(108px, auto));
    gap: clamp(28px, 4vw, 64px) clamp(36px, 7vw, 120px);
  }
  .lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .ln {
    stroke: #b7cde0;
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }
  .ln-voice {
    stroke: var(--accent-2);
    stroke-width: 3;
  }
  .ln-relay {
    stroke-dasharray: 5 6;
  }
  .ln-flow {
    stroke: #8fb4d4;
  }
  .pulse {
    stroke-width: 3;
    vector-effect: non-scaling-stroke;
    stroke-linecap: round;
    stroke-dasharray: 0.1 14;
    opacity: 0;
  }
  .pulse-voice {
    stroke: #0e7a35;
    stroke-width: 5;
  }
  .pulse-flow {
    stroke: var(--accent);
  }
  .node {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    padding: 14px 16px;
    border-radius: 16px;
    background: #f6fafd;
    border: 1px solid var(--line);
  }
  .node strong {
    font-weight: 850;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .node span {
    font-size: var(--step--1);
    line-height: 1.35;
    color: var(--muted);
  }
  .node.key {
    background: #ffffff;
    border-color: #9cc3e3;
    box-shadow: 0 10px 24px -16px rgb(28 117 184 / 0.6);
  }
  .tag {
    position: absolute;
    z-index: 2;
    translate: -50% -50%;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 850;
    white-space: nowrap;
  }
  .tag-ws {
    left: 66.6%;
    top: 16.6%;
    background: #dff3e6;
    color: #145c2c;
  }
  .tag-relay {
    left: 66.6%;
    top: 33.3%;
    background: #fff;
    color: var(--muted);
    border: 1px dashed #9db6cb;
  }

  @media (prefers-reduced-motion: no-preference) {
    .diagram:global(.is-live) .pulse {
      opacity: 1;
      animation: pulse 1.6s linear infinite;
    }
    .diagram:global(.is-live) .pulse-voice {
      animation-duration: 0.9s;
    }
  }
  @keyframes pulse {
    to {
      stroke-dashoffset: -14.1;
    }
  }

  @media (max-width: 720px) {
    .canvas {
      grid-template-rows: repeat(3, minmax(84px, auto));
      gap: 26px 18px;
    }
    .node {
      padding: 10px;
      border-radius: 12px;
    }
    .node strong {
      font-size: 0.8125rem;
    }
    .node span {
      display: none;
    }
    .tag {
      display: none;
    }
  }
</style>
