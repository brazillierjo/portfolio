---
// Bandeau de consentement pour Google Analytics. Rien n'est chargé chez Google
// tant que le visiteur n'a pas accepté ; refuser est aussi simple qu'accepter,
// et le choix se change depuis le pied de page (« Gérer les cookies »).
import { PROFILE } from "@/data/profile";
import { COPY, type Lang } from "@/i18n/copy";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = COPY[lang].consent;
---

<div
  class="consent sheet"
  role="region"
  aria-label={c.manage}
  data-consent
  data-ga={PROFILE.gaId}
  hidden
>
  <p>{c.text}</p>
  <div class="buttons">
    <button type="button" class="btn" data-consent-choice="denied">
      {c.refuse}
    </button>
    <button type="button" class="btn btn-green" data-consent-choice="granted">
      {c.accept}
    </button>
  </div>
</div>

<style>
  .consent {
    position: fixed;
    z-index: 60;
    left: 50%;
    bottom: max(16px, env(safe-area-inset-bottom));
    translate: -50% 0;
    width: min(calc(100% - 32px), 560px);
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px 14px 14px 20px;
    box-shadow: var(--shadow-float);
  }
  .consent[hidden] {
    display: none;
  }
  .consent p {
    margin: 0;
    font-size: var(--step--1);
    font-weight: 600;
    line-height: 1.45;
    color: var(--ink-2);
  }
  .buttons {
    display: flex;
    gap: 8px;
    flex: none;
  }
  .buttons .btn {
    min-height: 40px;
    padding: 0 14px;
    font-size: 0.9375rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    .consent:not([hidden]) {
      animation: consent-in 360ms var(--ease-out-soft) both;
    }
    @keyframes consent-in {
      from {
        opacity: 0;
        translate: -50% 12px;
      }
    }
  }
  @media (max-width: 560px) {
    .consent {
      flex-direction: column;
      align-items: stretch;
      padding: 16px;
    }
    .buttons .btn {
      flex: 1;
    }
  }
</style>
