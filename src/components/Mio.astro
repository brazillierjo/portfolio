---
import MioDiagram from "./MioDiagram.astro";
import Phone from "./Phone.astro";
import Project from "./Project.astro";
import Video from "./Video.astro";
import icon from "@/assets/mio/icon.png";
import lesson from "@/assets/mio/lesson.png";
import quiz from "@/assets/mio/quiz.png";
import reelPoster from "@/assets/mio/reel-poster.jpg";
import talk from "@/assets/mio/talk.png";
import today from "@/assets/mio/today.png";
import reelMp4 from "@/assets/video/mio-reel.mp4?url";
import { LINKS } from "@/data/profile";
import { COPY, type Lang } from "@/i18n/copy";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = COPY[lang];
const m = t.mio;
const screens = { today, talk, quiz, lesson } as const;
const stack = [
  "Expo 55",
  "React Native 0.83",
  "TypeScript",
  "Zustand",
  "TanStack Query",
  "MMKV",
  "Reanimated 4",
  "Swift",
  "Hono",
  "Node.js",
  "Supabase",
  "PostgreSQL",
  "Gemini Live",
  "Gemini 3",
  "Google Cloud TTS",
  "RevenueCat",
  "PostHog",
  "Sentry",
  "Next.js 16",
  "Remotion",
  "Docker",
  "Caddy",
  "GitHub Actions",
];
---

<Project
  id="mio"
  colors={{ accent: "#18a256", edge: "#138245", label: "#ffffff", stage: "#dcf1e4" }}
  name="Mio"
  icon={icon}
  teaser={m}
  lang={lang}
  links={[
    { href: LINKS.mio.site, label: m.links.site },
    { href: LINKS.mio.appStore, label: m.links.appStore },
    { href: LINKS.mio.play, label: m.links.play },
  ]}
>
  <div slot="visual" class="duo">
    <Phone
      src={talk}
      alt={m.steps[1]!.alt}
      class="duo-back"
      sizes="(min-width: 1024px) 220px, 40vw"
    />
    <Phone
      src={today}
      alt={m.steps[0]!.alt}
      class="duo-front"
      sizes="(min-width: 1024px) 220px, 40vw"
    />
  </div>

  <p class="lead intro">{m.intro}</p>

  <h4 class="h">{m.featuresTitle}</h4>
  <ol class="steps">
    {m.steps.map((s) => (
      <li>
        <Phone
          src={screens[s.id as keyof typeof screens]}
          alt={s.alt}
          sizes="(min-width: 1024px) 200px, 40vw"
        />
        <h5>{s.title}</h5>
        <p>{s.text}</p>
      </li>
    ))}
  </ol>

  <h4 class="h">{m.systemTitle}</h4>
  <p class="sys-intro">{m.systemIntro}</p>
  <MioDiagram lang={lang} />
  <div class="system">
    {m.system.map((s) => (
      <article>
        <h5>{s.title}</h5>
        <p>{s.text}</p>
      </article>
    ))}
  </div>

  <div class="social">
    <div class="social-text">
      <h4 class="h">{m.socialTitle}</h4>
      <p>{m.social}</p>
      <ul class="social-facts">
        {m.socialFacts.map((f) => (
          <li>{f}</li>
        ))}
      </ul>
    </div>
    <figure class="social-reel">
      <div class="reel">
        <Video
          src={reelMp4}
          poster={reelPoster}
          posterWidth={540}
          label={m.reelLabel}
          lang={lang}
        />
      </div>
      <figcaption>{m.reelLabel}</figcaption>
    </figure>
  </div>

  <h4 class="h">{t.stackLabel}</h4>
  <ul class="tags">
    {stack.map((s) => (
      <li>{s}</li>
    ))}
  </ul>
</Project>

<style>
  /* Aperçu : deux écrans de l'app, l'un devant l'autre */
  .duo {
    position: relative;
    width: min(100%, 440px);
    aspect-ratio: 440 / 470;
  }
  .duo :global(.duo-back),
  .duo :global(.duo-front) {
    position: absolute;
    width: 50%;
  }
  .duo :global(.duo-back) {
    right: 4%;
    top: 0;
    rotate: 4deg;
  }
  .duo :global(.duo-front) {
    left: 4%;
    top: 8%;
    rotate: -3deg;
  }

  .intro {
    margin: 0;
    max-width: 62ch;
  }
  .h {
    margin: clamp(36px, 4.5vw, 56px) 0 16px;
    font-size: var(--step-2);
    font-weight: 850;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }
  h5 {
    margin: 14px 0 6px;
    font-size: 1.125rem;
    font-weight: 850;
    line-height: 1.25;
    letter-spacing: -0.015em;
  }
  .steps p,
  .system p,
  .sys-intro,
  .social p {
    margin: 0;
    color: var(--muted);
  }
  .steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(16px, 2.4vw, 32px);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .steps :global(.phone) {
    width: min(100%, 210px);
  }
  .steps p {
    font-size: var(--step--1);
  }
  .sys-intro {
    max-width: 62ch;
  }
  .system {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 clamp(24px, 4vw, 56px);
    margin-top: clamp(20px, 2.4vw, 28px);
  }
  .system article {
    padding: 18px 0 22px;
    border-top: 1px solid var(--line);
  }
  .system h5 {
    margin-top: 0;
  }

  /* Le bloc mio-studio, en vert pour le distinguer du bleu de l'app */
  .social {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: clamp(24px, 5vw, 64px);
    align-items: center;
    margin-top: clamp(36px, 4.5vw, 56px);
    padding: clamp(24px, 4vw, 48px);
    border-radius: clamp(20px, 2.4vw, 28px);
    background: #0b6b5f;
    color: #fff;
    --muted: #d9f0ea;
    --heading: #fff;
    --line: rgb(255 255 255 / 0.2);
  }
  .social .h {
    margin-top: 0;
  }
  .social-facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 24px;
    list-style: none;
    padding: 0;
    margin: 22px 0 0;
  }
  .social-facts li {
    padding: 10px 0;
    border-top: 1px solid var(--line);
    font-weight: 850;
  }
  .social-reel {
    margin: 0;
    justify-self: center;
    width: min(100%, 280px);
  }
  .reel {
    aspect-ratio: 9 / 16;
    overflow: hidden;
    border-radius: 20px;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.18),
      0 24px 50px -20px rgb(0 0 0 / 0.55);
  }
  .social-reel figcaption {
    margin-top: 12px;
    text-align: center;
    font-size: var(--step--1);
    color: var(--muted);
  }

  @media (max-width: 960px) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 32px;
    }
  }
  @media (max-width: 860px) {
    .social {
      grid-template-columns: 1fr;
    }
    .social-reel {
      width: min(70%, 260px);
    }
    .duo {
      width: min(100%, 360px);
    }
  }
  @media (max-width: 600px) {
    .system,
    .social-facts {
      grid-template-columns: 1fr;
    }
  }
</style>
